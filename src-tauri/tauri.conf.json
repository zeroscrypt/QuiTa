{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuiTa",
  "version": "1.3.0",
  "identifier": "com.quita.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuiTa",
        "width": 420,
        "height": 600,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "hiddenTitle": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zeroscrypt/QuiTa/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NEUwMjBERDg3MDFGMUYKUldRZkgzRFlEUUpPbGY2VzNiendWSXlhbXJDenpnM1BTMDN6NVJBbUZNSXFNQ1lzYkpLeEZGT2gK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
