{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "QuiTa",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Новое" },
    { "type": "fix", "section": "Исправлено" },
    { "type": "perf", "section": "Производительность" },
    { "type": "refactor", "section": "Рефакторинг" },
    { "type": "docs", "section": "Документация", "hidden": true },
    { "type": "test", "section": "Тесты", "hidden": true },
    { "type": "ci", "section": "Сборка и CI", "hidden": true },
    { "type": "chore", "section": "Прочее", "hidden": true }
  ]
}